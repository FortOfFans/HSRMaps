		"phases": [
			{
				"id": "10071",
				"name": "阶段一：万众齐颂",
				"description": "首领幻影会释放【于梦中起舞】和【在雨中高歌】造成高额伤害。",
				"answer": "应对策略：在【于梦中起舞】和【在雨中高歌】施放前尽可能击破召唤物。",
				"skills": [
					{
						"id": "100711",
						"type": "Normal",
						"name": "如何充能和使用【遥远地平的长音】",
						"texts": [
							{
								"description": "召唤物被弱点击破后会为【遥远地平的长音】充能。【遥远地平的长音】能对敌方全体造成韧性削减，尽可能使其命中更多未进入弱点击破状态的敌人，使韧性削减收益最大化。",
								"params": []
							}
						]
					},
					{
						"id": "100712",
						"type": "Normal",
						"name": "应对首领幻影的【于梦中起舞】和【在雨中高歌】造成的伤害",
						"texts": [
							{
								"description": "尽可能击破召唤物，以削弱【于梦中起舞】和【在雨中高歌】的伤害。未被击破的召唤物越多，首领幻影【于梦中起舞】和【在雨中高歌】造成的伤害越高。当所有召唤物都处于被击破状态时，首领幻影施放【于梦中起舞】和【在雨中高歌】时会使自身受到韧性削减。",
								"params": []
							}
						]
					},
					{
						"id": "100713",
						"type": "Normal",
						"name": "应对【异梦】状态的控制效果",
						"texts": [
							{
								"description": "提高效果抵抗或使用技能解除【异梦】状态。",
								"params": []
							}
						]
					}
				]
			},
			{
				"id": "10072",
				"name": "阶段二：最终乐章",
				"description": "【旧梦的回声】不会离开战场，【太初有为】不会被打断。",
				"answer": "应对策略：击破敌方韧性为【遥远地平的长音】充能，同时为我方获取护盾。",
				"skills": [
					{
						"id": "100721",
						"type": "Normal",
						"name": "应对首领幻影的【太初有为】造成的伤害",
						"texts": [
							{
								"description": "击破召唤物或削弱首领幻影的韧性，可以获取护盾以抵挡【太初有为】。",
								"params": []
							}
						]
					}
				]
			}
		],
		"guides": [
			{
				"description": "首领幻影和其召唤物受到的伤害降低<color=#f29e38ff><unbreak>#1[i]%</unbreak></color>。<color=#f29e38ff>弱点击破</color>后，行动额外延后，受到的伤害提高<color=#f29e38ff><unbreak>#2[i]%</unbreak></color>。",
				"params": [
					0.5,
					1,
					1.5
				]
			},
			{
				"description": "召唤物被<color=#f29e38ff>弱点击破</color>时，首领幻影会削减一定韧性。召唤物被<color=#f29e38ff>弱点击破</color>后会为【遥远地平的长音】充能，施放【遥远地平的长音】对敌方全体造成高额伤害并削减韧性。",
				"params": []
			},
			{
				"description": "首领幻影会将<color=#f29e38ff>自身弱点属性分享给召唤物</color>。任一召唤物被<color=#f29e38ff>弱点击破</color>时，该召唤物的弱点属性会被<color=#f29e38ff>添加</color>给所有敌方目标。",
				"params": []
			}
		],
		"texts": [
			{
				"description": "<color=#f29e38ff>击破</color>首领幻影会大幅提高首领幻影和其召唤物受到的伤害，使我方全体恢复战技点并激活终结技。",
				"params": []
			},
			{
				"description": "多次击破<color=#f29e38ff>召唤物</color>可有效为【遥远地平的长音】充能，施放【遥远地平的长音】对敌方全体造成韧性削减。",
				"params": []
			},
			{
				"description": "优先击破弱点属性有利于我方角色伤害类型的<color=#f29e38ff>召唤物</color>，使其弱点属性<color=#f29e38ff>分享</color>给所有敌方目标。",
