		"phases": [
			{
				"id": "10071",
				"name": "第一段階：万民斉頌",
				"description": "ボス幻影が「夢の中で踊る」と「雨の中に歌えば」を発動し、大ダメージを与える。",
				"answer": "対応戦略：「夢の中で踊る」と「雨の中に歌えば」が発動する前に召喚物をできるだけ倒す。",
				"skills": [
					{
						"id": "100711",
						"type": "Normal",
						"name": "「遥かなる地平の長音」のチャージ方法と発動方法",
						"texts": [
							{
								"description": "召喚物が弱点撃破された後、「遥かなる地平の長音」をチャージする。「遥かなる地平の長音」は敵全体の靭性を削ることができる。できるだけ多くの弱点撃破状態にない敵に命中させることで、靭性を削る効果を最大限有効活用できる。",
								"params": []
							}
						]
					},
					{
						"id": "100712",
						"type": "Normal",
						"name": "ボス幻影が発動する「夢の中で踊る」と「雨の中に歌えば」が与えるダメージの対処法",
						"texts": [
							{
								"description": "できるだけ召喚物を弱点撃破して「夢の中で踊る」と「雨の中に歌えば」によるダメージをダウンさせる。弱点撃破状態にない召喚物が多いほど、ボス幻影の「夢の中で踊る」と「雨の中に歌えば」の与ダメージがアップする。すべての召喚物が弱点撃破状態にある時、ボス幻影の発動する「夢の中で踊る」と「雨の中に歌えば」は自身の靭性を削る。",
								"params": []
							}
						]
					},
					{
						"id": "100713",
						"type": "Normal",
						"name": "「異夢」状態への対処法",
						"texts": [
							{
								"description": "効果抵抗をアップさせるか、またはスキルを使用して「異夢」状態を解除する。",
								"params": []
							}
						]
					}
				]
			},
			{
				"id": "10072",
				"name": "第二段階：最終楽章",
				"description": "「往日の夢のこだま」は戦闘フィールドから離れず、「初めに行為ありき」は中断されない。",
				"answer": "対応戦略：敵を弱点撃破することで「遥かなる地平の長音」をチャージし、味方にバリアを付与する。",
				"skills": [
					{
						"id": "100721",
						"type": "Normal",
						"name": "ボス幻影の「初めに行為ありき」の与えるダメージの対処法",
						"texts": [
							{
								"description": "召喚物を弱点撃破またはボス幻影の靭性を削ることで、「初めに行為ありき」を防ぐバリアを獲得できる。",
								"params": []
							}
						]
					}
				]
			}
		],
		"guides": [
			{
				"description": "ボス幻影とその召喚物の受けるダメージ-<color=#f29e38ff><unbreak>#1[i]%</unbreak></color>。<color=#f29e38ff>弱点撃破</color>された後、さらに行動順が遅延され、受けるダメージ+<color=#f29e38ff><unbreak>#2[i]%</unbreak></color>。",
				"params": [
					0.5,
					1,
					1.5
				]
			},
			{
				"description": "召喚物が<color=#f29e38ff>弱点撃破</color>された時、ボス幻影の靭性が一定値削れる。召喚物が<color=#f29e38ff>弱点撃破</color>された後、「遥かなる地平の長音」はチャージを獲得する。「遥かなる地平の長音」を発動すると敵全体に大ダメージを与え、靭性を削ることができる。",
				"params": []
			},
			{
				"description": "ボス幻影は<color=#f29e38ff>自身の弱点属性を召喚物にシェアする</color>。いずれかの召喚物が<color=#f29e38ff>弱点撃破</color>される時、その召喚物の弱点属性がすべての敵に<color=#f29e38ff>付与</color>される。",
				"params": []
			}
		],
		"texts": [
			{
				"description": "ボス幻影の<color=#f29e38ff>弱点を撃破</color>すると、ボス幻影と召喚物の受けるダメージが大アップし、味方全体のSPを回復して必殺技を発動できるようにする。",
				"params": []
			},
			{
				"description": "複数回<color=#f29e38ff>召喚物</color>を弱点撃破することで「遥かなる地平の長音」のチャージを進め、「遥かなる地平の長音」を発動して敵全体の靭性を削ることができる。",
				"params": []
			},
			{
				"description": "味方キャラに有利な弱点属性を持つ<color=#f29e38ff>召喚物</color>を優先的に弱点撃破することで、その弱点属性をすべての敵に<color=#f29e38ff>シェア</color>できる。",
